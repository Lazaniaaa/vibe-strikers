{
  "name": "voxel-character-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "verify": "node src/characters/verify.mjs",
    "game:dev": "vite --config vite.game.config.ts",
    "game:build": "vite build --config vite.game.config.ts",
    "typecheck": "node scripts/typecheck-game.mjs",
    "test:gameplay": "node --experimental-strip-types --no-warnings src/gameplay/gameplay.test.ts",
    "game:preview": "vite preview --config vite.game.config.ts --host 127.0.0.1 --port 5191 --strictPort",
    "server:publish": "spacetime publish --server local -y --module-path server voxel-arena",
    "server:bindings": "spacetime generate --lang typescript --module-path server --out-dir src/network/bindings -y",
    "server:reset": "spacetime publish --server local -y --delete-data=always --module-path server voxel-arena"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/rapier": "2.2.0",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "spacetimedb": "2.14.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
