{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    /* Required by SpacetimeDB (lib widened to ES2022 for Object.hasOwn used by src/maps). */
    "target": "ESNext",
    "lib": ["ES2022", "dom"],
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true,
    "types": []
  },
  "include": ["./src/**/*"]
}
